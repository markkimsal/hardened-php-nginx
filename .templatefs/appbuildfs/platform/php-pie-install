#!/bin/sh

EXPECTED_CHECKSUM="19a31ddd4bfd08b9eb5eaad2e5f63e76e7919cae7683852da41c80da704ad6c0"
php -r "copy('https://github.com/php/pie/releases/download/1.4.9/pie.phar', 'pie.phar');"
if [ $? -ne 0 ]
then
    >&2 echo 'ERROR: unable to download'
    exit 1
fi

ACTUAL_CHECKSUM="$(php -r "echo hash_file('sha256', 'pie.phar');")"

if [ "$EXPECTED_CHECKSUM" != "$ACTUAL_CHECKSUM" ]
then
    >&2 echo 'ERROR: Invalid installer checksum ' $ACTUAL_CHECKSUM
    rm pie.phar
    exit 1
fi

mv pie.phar /opt/php/bin/pie
chmod a+x /opt/php/bin/pie
